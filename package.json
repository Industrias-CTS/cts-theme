{
	"name": "@industriascts/cts-theme",
	"version": "0.1.0",
	"description": "Sistema de Diseño CTS: tokens, colores y tema MUI para las aplicaciones de Industrias CTS",
	"license": "UNLICENSED",
	"private": true,
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"files": [
		"dist",
		"eslint"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./colors": {
			"types": "./dist/colors.d.ts",
			"default": "./dist/colors.js"
		},
		"./tokens": {
			"types": "./dist/tokens.d.ts",
			"default": "./dist/tokens.js"
		},
		"./format": {
			"types": "./dist/format.d.ts",
			"default": "./dist/format.js"
		},
		"./mui": {
			"types": "./dist/mui/theme.d.ts",
			"default": "./dist/mui/theme.js"
		},
		"./views": {
			"types": "./dist/views/index.d.ts",
			"default": "./dist/views/index.js"
		},
		"./css": "./dist/cts-theme.css",
		"./eslint": "./eslint/index.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -p tsconfig.json && node scripts/build-css.mjs",
		"clean": "rm -rf dist",
		"typecheck": "tsc -p tsconfig.check.json",
		"typecheck:mui6": "tsc -p tsconfig.check.mui6.json",
		"typecheck:mui7": "tsc -p tsconfig.check.mui7.json",
		"typecheck:mui9": "tsc -p tsconfig.check.json",
		"typecheck:matrix": "pnpm typecheck:mui6 && pnpm typecheck:mui7 && pnpm typecheck:mui9",
		"lint": "eslint .",
		"check": "pnpm typecheck:matrix && pnpm lint && pnpm build",
		"prepare": "pnpm build",
		"catalogo": "storybook dev -p 6006 --no-open",
		"catalogo:build": "storybook build -o storybook-static --quiet"
	},
	"peerDependencies": {
		"@mui/material": "^6 || ^7 || ^9",
		"eslint": "^9",
		"react": "^18 || ^19"
	},
	"devDependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^9.4.0",
		"@mui/material": "^9.4.0",
		"@storybook/addon-docs": "10.6.5",
		"@storybook/addon-themes": "10.6.5",
		"@storybook/react-vite": "10.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^5.2.0",
		"eslint": "^9.39.5",
		"mui6": "npm:@mui/material@^6.5.0",
		"mui7": "npm:@mui/material@^7.3.11",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"storybook": "10.6.5",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^7.3.7"
	},
	"peerDependenciesMeta": {
		"eslint": {
			"optional": true
		}
	}
}
